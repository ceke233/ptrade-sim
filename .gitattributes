# 统一行尾为 LF，避免 Windows 上编辑后把整文件变成 CRLF 导致 diff 变脏。
#
# 背景：本仓库曾出现 runtime.py 全为 CRLF、其余源文件为 LF 的情况 ——
# 功能无影响，但任何一次改动都会把整个文件标记为已修改，review 时看不出真实变更。
# 这条规则让 Git 在检出/提交时自动归一，不再依赖编辑器设置。

* text=auto eol=lf

# 明确按文本处理的源码与配置
*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.txt   text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf

# 二进制：不要做任何行尾转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.parquet binary
*.duckdb  binary
*.duckdb.wal binary
*.xlsx  binary
*.zip   binary
*.gz    binary

# Windows 专用脚本保留 CRLF（否则某些工具会出问题）
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
